# ── Angel SmartAPI ─────────────────────────────────────────────────────────────
# Variable names match the existing AngelOne login class exactly
ANGEL_API_KEY=your_angel_api_key              # from Angel One developer portal
ANGEL_USERNAME=A123456                        # your Client Code (not email)
ANGEL_PIN=1234                                # 4-digit trading MPIN
ANGEL_TOTP_SECRET=BASE32SECRETHERE           # base-32 key shown when setting up TOTP in Angel app

# ── Angel rate limits (optional – defaults shown) ──────────────────────────────
ANGEL_BASE_DELAY=0.6
ANGEL_SEARCH_DELAY=3.0
ANGEL_LTP_DELAY=1.0

# ── Zerodha Kite ───────────────────────────────────────────────────────────────
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_USER_ID=AB1234                           # Zerodha Client ID
KITE_PASSWORD=your_kite_password
KITE_PIN=123456                               # 6-digit 2FA PIN used on Kite login page

# ── Strategy ───────────────────────────────────────────────────────────────────
# Candle interval and trade times are configured per-instrument in config.py
DRY_RUN=false                                # set true for paper trading (no real orders)
DATA_PROVIDER=angel                          # angel (free) or kite (requires paid Kite historical data API)
TRADING_DAYS_ONLY=true                       # set false to enable notifications/trading on weekends

# ── Stock Futures (optional, SEED VALUES ONLY) ─────────────────────────────────
# Comma-separated NSE stock names to trade as futures (NFO FUTSTK).
# The algo auto-resolves the nearest futures contract at startup.
# Same supertrend + MA strategy as NIFTY/BANKNIFTY; runs after index instruments.
#
# IMPORTANT: these three values are read ONCE, to create instrument_config.json
# on first start. After that the dashboard Settings page is the source of truth
# and editing them here has no effect — add and remove stocks at /settings.
# Delete instrument_config.json to re-seed from these values.
STOCK_FUTURES=RELIANCE,HDFCBANK,TCS         # example — set your own list
STOCK_FUTURES_QTY=1                          # lots per stock (default 1)
STOCK_FUTURES_PRODUCT=NRML                   # NRML (positional) or MIS (intraday)

# ── Service restart button (dashboard) ─────────────────────────────────────────
# The dashboard "Restart Service" button runs:
#     sudo -n systemctl restart --no-block <SERVICE_NAME>
# which needs the passwordless sudo rule from DEPLOYMENT.txt section 8a.
# SERVICE_NAME    – systemd unit name (default: simplealgo)
# RESTART_COMMAND – overrides the whole command; required on Windows, where
#                   systemd does not exist (the button is hidden without it).
SERVICE_NAME=simplealgo
# RESTART_COMMAND=
