# ── Angel SmartAPI ─────────────────────────────────────────────────────────────
# Variable names match the existing AngelOne login class exactly
ANGEL_API_KEY=your_angel_api_key              # from Angel One developer portal
ANGEL_USERNAME=A123456                        # your Client Code (not email)
ANGEL_PIN=1234                                # 4-digit trading MPIN
ANGEL_TOTP_SECRET=BASE32SECRETHERE           # base-32 key shown when setting up TOTP in Angel app

# ── Angel rate limits (optional – defaults shown) ──────────────────────────────
ANGEL_BASE_DELAY=2.0
ANGEL_SEARCH_DELAY=3.0
ANGEL_LTP_DELAY=1.0

# ── Zerodha Kite ───────────────────────────────────────────────────────────────
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_USER_ID=AB1234                           # Zerodha Client ID
KITE_PASSWORD=your_kite_password
KITE_PIN=123456                               # 6-digit 2FA PIN used on Kite login page

# ── Strategy ───────────────────────────────────────────────────────────────────
# Candle interval and trade times are configured per-instrument in config.py
DRY_RUN=false                                # set true for paper trading (no real orders)
TRADING_DAYS_ONLY=true                       # set false to enable notifications/trading on weekends
