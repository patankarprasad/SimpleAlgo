ExecStart=/usr/bin/find /opt/algo/kotak_zerodha_prasad_patankar/logs -maxdepth 1 -type f -name 'Logfile_*' -delete
ExecStart=/usr/bin/find /opt/algo/kotak_zerodha_prasad_patankar/logs -maxdepth 1 -type d -name '????-??-??' -exec rm -rf {} +
